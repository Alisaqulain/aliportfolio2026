# Site — set this in Vercel Environment Variables too
NEXT_PUBLIC_SITE_URL=https://aliportfolio2026.vercel.app

# Social profiles — replace placeholders with your real URLs
NEXT_PUBLIC_GITHUB_URL=https://github.com/PLACEHOLDER_GITHUB
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/PLACEHOLDER_LINKEDIN

# Project live demo URLs (optional)
NEXT_PUBLIC_ALI_GPT_URL=
NEXT_PUBLIC_APNA_VIDEO_CALL_URL=
NEXT_PUBLIC_ALI_IRCTIC_URL=
NEXT_PUBLIC_ZERODHA_CLONE_URL=
NEXT_PUBLIC_CHATAPP_URL=
NEXT_PUBLIC_AIRBNB_CLONE_URL=

# Project GitHub URLs (optional)
NEXT_PUBLIC_ALI_GPT_GITHUB=
NEXT_PUBLIC_APNA_VIDEO_CALL_GITHUB=
NEXT_PUBLIC_ALI_IRCTIC_GITHUB=
NEXT_PUBLIC_ZERODHA_CLONE_GITHUB=
NEXT_PUBLIC_CHATAPP_GITHUB=
NEXT_PUBLIC_AIRBNB_CLONE_GITHUB=

# MCA Dashboard (server-side only — do not prefix with NEXT_PUBLIC_)
MCA_DASHBOARD_PASSWORD=
MCA_SESSION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/mca/google/callback

# Optional: enable /check and /api/mca/check on production (default: dev only)
# MCA_ENV_CHECK_ENABLED=true
# MCA_ENV_CHECK_SECRET=your_random_secret_for_check_url
